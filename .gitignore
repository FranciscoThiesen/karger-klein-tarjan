/.build/
/bin/
/bazel-*

# Rebuild standalone viewers from tracked templates, scripts, and graph exports.
/benchmark/results/**/*.html
!/benchmark/results/**/*.template.html
/docs/kkt-report/report.html
/docs/kkt-report/graph-explorer.html
/docs/kkt-report/explorer_fragment.html

# Full machine power history stays local; publish scoped audit summaries only.
benchmark/results/search-2026-10-13/*-power-audit/pmset.log
benchmark/results/search-2026-10-13/*-power-audit/events.json
